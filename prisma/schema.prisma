generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  DONO
  FINANCEIRO
  COMERCIAL
}

enum TipoMidia {
  LED
  TOTEM
  TRIEDRO
  OUTDOOR
}

enum StatusContrato {
  ATIVO
  ENCERRADO
  CANCELADO
}

enum FormaPagamento {
  PIX
  BOLETO
  TRANSFERENCIA
  CARTAO
  DINHEIRO
  OUTRO
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(COMERCIAL)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
}

model Cliente {
  id          String     @id @default(cuid())
  nome        String // Cliente/Empresa
  documento   String? // CPF ou CNPJ
  contato     String? // Pessoa de contato
  telefone    String?
  email       String?
  observacoes String?
  ativo       Boolean    @default(true)
  criadoEm    DateTime   @default(now())
  contratos   Contrato[]
}

// Um ponto de mídia: painel de LED, totem, triedro ou outdoor.
model Ponto {
  id          String          @id @default(cuid())
  tipo        TipoMidia
  nome        String // "Ponto do LED": nome/local de instalação
  endereco    String?
  observacoes String?
  ativo       Boolean         @default(true)
  criadoEm    DateTime        @default(now())
  contratos   ContratoPonto[]
}

model Contrato {
  id             String          @id @default(cuid())
  numero         Int             @unique @default(autoincrement())
  clienteId      String
  cliente        Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  // Valor cobrado por mês (todos os pontos do contrato somados).
  valorMensal    Decimal         @db.Decimal(12, 2)
  formaPagamento FormaPagamento  @default(PIX)
  inicio         DateTime        @db.Date
  prazoMeses     Int
  fim            DateTime        @db.Date
  diaVencimento  Int // 1 a 28
  status         StatusContrato  @default(ATIVO)
  observacoes    String?
  criadoEm       DateTime        @default(now())
  pontos         ContratoPonto[]
  parcelas       Parcela[]

  @@index([clienteId])
  @@index([status, fim])
}

model ContratoPonto {
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  pontoId    String
  ponto      Ponto    @relation(fields: [pontoId], references: [id], onDelete: Restrict)

  @@id([contratoId, pontoId])
  @@index([pontoId])
}

// Cobrança mensal. "Recebimento" da planilha = pagoEm preenchido.
// Atraso e inadimplência são calculados (pagoEm nulo e vencimento passado), não digitados.
model Parcela {
  id            String          @id @default(cuid())
  contratoId    String
  contrato      Contrato        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero        Int
  vencimento    DateTime        @db.Date
  valor         Decimal         @db.Decimal(12, 2)
  pagoEm        DateTime?       @db.Date
  valorPago     Decimal?        @db.Decimal(12, 2)
  formaRecebida FormaPagamento?
  observacoes   String?

  @@unique([contratoId, numero])
  @@index([vencimento])
  @@index([pagoEm])
}
