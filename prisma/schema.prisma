generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  DONO
  FINANCEIRO
  COMERCIAL
}

enum TipoMidia {
  LED
  TOTEM
  TRIEDRO
  OUTDOOR
}

enum StatusContrato {
  ATIVO
  ENCERRADO
  CANCELADO
}

enum CategoriaDespesa {
  ENERGIA
  MANUTENCAO
  ALUGUEL_PONTO
  IMPOSTOS
  COMISSOES
  FOLHA
  MARKETING
  PRODUCAO
  OUTROS
}

// Serviços da tabela de custos do outdoor.
enum CustoItem {
  IMPRESSAO
  LONA
  COLAGEM
  MONTAGEM
  RASPAGEM
}

// Andamento da conversa de renovação de um ponto de contrato que está para terminar.
enum StatusRenovacao {
  A_CONTATAR
  EM_NEGOCIACAO
  VAI_RENOVAR
  NAO_RENOVA
}

enum StatusProposta {
  ENVIADA
  NEGOCIANDO
  FECHADA
  PERDIDA
}

enum TipoOcorrencia {
  DEFEITO
  MANUTENCAO_PREVENTIVA
  LIMPEZA
  TROCA_PECA
  OUTRO
}

enum StatusOcorrencia {
  ABERTA
  EM_ANDAMENTO
  RESOLVIDA
}

enum CategoriaArquivo {
  FOTO_PONTO
  VEICULACAO
  CONTRATO_ASSINADO
  COMPROVANTE
  OUTRO
}

enum FormaPagamento {
  PIX
  BOLETO
  TRANSFERENCIA
  CARTAO
  DINHEIRO
  OUTRO
  PERMUTA
}

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  papel        Papel     @default(COMERCIAL)
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  // Proteção do login: bloqueio temporário após várias senhas erradas.
  tentativas   Int       @default(0)
  bloqueadoAte DateTime?
  // Marcada no login quando a senha digitada não atende à regra de senha forte (aviso para trocar).
  senhaFraca   Boolean   @default(false)
  // O que a pessoa pode ver/fazer (chaves de src/lib/permissoes.ts). O Dono sempre tem tudo, independentemente desta lista.
  permissoes   String[]  @default([])

  contratosVendidos Contrato[]
  propostas         Proposta[]
  fechamentos       ComissaoFechamento[]
  pushInscricoes    PushInscricao[]
}

model Cliente {
  id          String     @id @default(cuid())
  nome        String // Cliente/Empresa
  documento   String? // CPF ou CNPJ
  contato     String? // Pessoa de contato
  telefone    String?
  email       String?
  observacoes String?
  ativo       Boolean    @default(true)
  criadoEm    DateTime   @default(now())
  contratos   Contrato[]
  propostas   Proposta[]
  arquivos    Arquivo[]
}

// Um ponto de mídia: painel de LED, totem, triedro ou outdoor.
model Ponto {
  id                  String          @id @default(cuid())
  tipo                TipoMidia
  nome                String // "Ponto do LED": nome/local de instalação
  endereco            String?
  observacoes         String?
  // Quantos anunciantes cabem ao mesmo tempo no ponto; nulo = sem limite.
  cotas               Int?
  // Ficha do ponto
  latitude            Float?
  longitude           Float?
  larguraM            Decimal?        @db.Decimal(6, 2)
  alturaM             Decimal?        @db.Decimal(6, 2)
  resolucao           String?
  proprietario        String? // dono do imóvel/terreno
  proprietarioContato String?
  // Formato do outdoor (ex.: "9x3"), usado na tabela de custos.
  formato             String?
  ativo               Boolean         @default(true)
  criadoEm            DateTime        @default(now())
  contratos           ContratoPonto[]
  despesas            Despesa[]
  ocorrencias         Ocorrencia[]
  arquivos            Arquivo[]
  propostaPontos      PropostaPonto[]
}

model Contrato {
  id             String          @id @default(cuid())
  numero         Int             @unique @default(autoincrement())
  clienteId      String
  cliente        Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  formaPagamento FormaPagamento  @default(PIX)
  // Só para forma PERMUTA: o que o cliente dá em troca (não gera parcelas a receber).
  permutaDescricao String?
  // Derivados dos pontos: menor início e maior fim (cada ponto tem o seu prazo e valor).
  inicio         DateTime        @db.Date
  fim            DateTime        @db.Date
  diaVencimento  Int // 1 a 28
  status         StatusContrato  @default(ATIVO)
  observacoes    String?
  vendedorId     String?
  vendedor       Usuario?        @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  comissaoPct    Decimal?        @db.Decimal(5, 2)
  // Link público (sem login) do relatório de veiculação para o cliente; nulo = não compartilhado.
  tokenPublico   String?         @unique
  criadoEm       DateTime        @default(now())
  pontos         ContratoPonto[]
  parcelas       Parcela[]
  reajustes      Reajuste[]
  acordos        Acordo[]
  arquivos       Arquivo[]
  proposta       Proposta?

  @@index([clienteId])
  @@index([status, fim])
}

// Cada ponto do contrato tem valor mensal, início e prazo próprios; a cobrança do mês é a soma dos pontos vigentes.
model ContratoPonto {
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  pontoId    String
  ponto      Ponto    @relation(fields: [pontoId], references: [id], onDelete: Restrict)
  valor      Decimal  @db.Decimal(12, 2)
  inicio     DateTime @db.Date
  prazoMeses Int
  fim        DateTime @db.Date
  // Conversa de renovação (volta a "A contatar" quando o ponto é renovado).
  renovacao  StatusRenovacao @default(A_CONTATAR)
  // Reserva o ponto inteiro (ocupa todas as cotas), ex.: outdoor contratado por um ano.
  ocupaTudo  Boolean @default(false)

  @@id([contratoId, pontoId])
  @@index([pontoId])
}

// Cobrança mensal. "Recebimento" da planilha = pagoEm preenchido.
// Atraso e inadimplência são calculados (pagoEm nulo e vencimento passado), não digitados.
model Parcela {
  id              String          @id @default(cuid())
  contratoId      String
  contrato        Contrato        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero          Int
  vencimento      DateTime        @db.Date
  valor           Decimal         @db.Decimal(12, 2)
  pagoEm          DateTime?       @db.Date
  valorPago       Decimal?        @db.Decimal(12, 2)
  formaRecebida   FormaPagamento?
  observacoes     String?
  // Renegociação: parcelas vencidas trocadas por um acordo ficam "renegociadas" (saem da inadimplência, mantêm o histórico);
  // as parcelas novas do acordo apontam para ele em `acordoId`.
  renegociadaEm   DateTime?       @db.Date
  renegociadaNoId String?
  renegociadaNo   Acordo?         @relation("AcordoRenegociadas", fields: [renegociadaNoId], references: [id], onDelete: SetNull)
  acordoId        String?
  acordo          Acordo?         @relation("AcordoGeradas", fields: [acordoId], references: [id], onDelete: SetNull)

  @@unique([contratoId, numero])
  @@index([vencimento])
  @@index([pagoEm])
}

// Conta a pagar. Pode estar ligada a um ponto (aluguel do local, energia, manutenção) para medir o lucro por ponto.
model Despesa {
  id          String              @id @default(cuid())
  descricao   String
  categoria   CategoriaDespesa    @default(OUTROS)
  fornecedor  String?
  pontoId     String?
  ponto       Ponto?              @relation(fields: [pontoId], references: [id], onDelete: SetNull)
  valor       Decimal             @db.Decimal(12, 2)
  vencimento  DateTime            @db.Date
  pagoEm      DateTime?           @db.Date
  valorPago   Decimal?            @db.Decimal(12, 2)
  observacoes String?
  // Despesas criadas juntas pela repetição mensal compartilham o mesmo grupo.
  grupo       String?
  criadoEm    DateTime            @default(now())
  comissao    ComissaoFechamento?
  ocorrencia  Ocorrencia?

  @@index([vencimento])
  @@index([pagoEm])
}

// Aparelho que aceitou receber notificações (Web Push).
model PushInscricao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

// Tabela de custos do outdoor: valor de cada serviço por formato (item ausente = não se aplica).
model CustoOutdoor {
  id      String    @id @default(cuid())
  formato String
  item    CustoItem
  valor   Decimal   @db.Decimal(12, 2)

  @@unique([formato, item])
}

// Configurações da empresa e regras de cobrança (uma linha só, id fixo).
model Config {
  id           String  @id @default("singleton")
  razaoSocial  String?
  nomeFantasia String?
  cnpj         String?
  endereco     String?
  cidade       String?
  telefone     String?
  email        String?
  // Encargos sobre parcelas em atraso: multa única e juros ao mês (pro rata por dia).
  multaPct     Decimal @default(2) @db.Decimal(5, 2)
  jurosMesPct  Decimal @default(1) @db.Decimal(5, 2)
}

model Reajuste {
  id          String   @id @default(cuid())
  contratoId  String
  contrato    Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  percentual  Decimal  @db.Decimal(6, 2)
  indice      String? // "IGP-M", "IPCA", "Acordo"...
  aplicadoEm  DateTime @db.Date
  observacoes String?
  usuarioNome String?
  criadoEm    DateTime @default(now())

  @@index([contratoId])
}

model Proposta {
  id           String          @id @default(cuid())
  numero       Int             @unique @default(autoincrement())
  clienteId    String
  cliente      Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedorId   String?
  vendedor     Usuario?        @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  status       StatusProposta  @default(ENVIADA)
  validadeAte  DateTime?       @db.Date
  prazoMeses   Int             @default(12)
  observacoes  String?
  motivoPerda  String?
  contratoId   String?         @unique
  contrato     Contrato?       @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt
  pontos       PropostaPonto[]

  @@index([status])
}

model PropostaPonto {
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  pontoId    String
  ponto      Ponto    @relation(fields: [pontoId], references: [id], onDelete: Restrict)
  valor      Decimal  @db.Decimal(12, 2)

  @@id([propostaId, pontoId])
}

// Fechamento mensal de comissão de um vendedor: vira uma despesa (categoria COMISSOES).
model ComissaoFechamento {
  id         String   @id @default(cuid())
  vendedorId String
  vendedor   Usuario  @relation(fields: [vendedorId], references: [id], onDelete: Restrict)
  mes        String // "2026-10"
  base       Decimal  @db.Decimal(12, 2) // total recebido no mês dos contratos do vendedor
  valor      Decimal  @db.Decimal(12, 2)
  despesaId  String?  @unique
  despesa    Despesa? @relation(fields: [despesaId], references: [id], onDelete: SetNull)
  criadoEm   DateTime @default(now())

  @@unique([vendedorId, mes])
}

model Ocorrencia {
  id            String           @id @default(cuid())
  pontoId       String
  ponto         Ponto            @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  titulo        String
  descricao     String?
  tipo          TipoOcorrencia   @default(DEFEITO)
  status        StatusOcorrencia @default(ABERTA)
  abertaEm      DateTime         @db.Date
  resolvidaEm   DateTime?        @db.Date
  custo         Decimal?         @db.Decimal(12, 2)
  responsavel   String?
  despesaId     String?          @unique
  despesa       Despesa?         @relation(fields: [despesaId], references: [id], onDelete: SetNull)
  criadoPorNome String?
  criadoEm      DateTime         @default(now())
  arquivos      Arquivo[]

  @@index([status])
  @@index([pontoId])
}

// Arquivos guardados no próprio banco (fotos reduzidas e PDFs pequenos). Nunca selecionar `dados` em listagens.
model Arquivo {
  id             String           @id @default(cuid())
  nome           String
  mime           String
  tamanho        Int
  dados          Bytes
  categoria      CategoriaArquivo @default(OUTRO)
  descricao      String?
  dataRef        DateTime?        @db.Date
  contratoId     String?
  contrato       Contrato?        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  pontoId        String?
  ponto          Ponto?           @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  ocorrenciaId   String?
  ocorrencia     Ocorrencia?      @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  clienteId      String?
  cliente        Cliente?         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  enviadoPorNome String?
  criadoEm       DateTime         @default(now())

  @@index([contratoId])
  @@index([pontoId])
  @@index([ocorrenciaId])
  @@index([clienteId])
}

// Histórico de quem fez o quê.
model Auditoria {
  id          String   @id @default(cuid())
  usuarioId   String?
  usuarioNome String
  acao        String
  entidade    String
  entidadeId  String?
  resumo      String
  criadoEm    DateTime @default(now())

  @@index([criadoEm])
  @@index([entidade, entidadeId])
}

// Negociação de dívida: troca parcelas vencidas por novas parcelas (com entrada e desconto opcionais).
model Acordo {
  id            String    @id @default(cuid())
  numero        Int       @unique @default(autoincrement())
  contratoId    String
  contrato      Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  totalOriginal Decimal   @db.Decimal(12, 2) // soma das parcelas vencidas com multa e juros, na data do acordo
  desconto      Decimal   @default(0) @db.Decimal(12, 2)
  totalAcordado Decimal   @db.Decimal(12, 2)
  entrada       Decimal   @default(0) @db.Decimal(12, 2)
  parcelas      Int // quantidade de parcelas do saldo (depois da entrada)
  primeiroVenc  DateTime  @db.Date
  observacoes   String?
  usuarioNome   String?
  criadoEm      DateTime  @default(now())
  geradas       Parcela[] @relation("AcordoGeradas")
  renegociadas  Parcela[] @relation("AcordoRenegociadas")

  @@index([contratoId])
}

// Meta de faturamento (valor a receber) de um mês.
model Meta {
  id    String  @id @default(cuid())
  mes   String  @unique // "2026-10"
  valor Decimal @db.Decimal(12, 2)
}
